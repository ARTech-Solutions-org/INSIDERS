{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm install && cd artifacts/api-server && node ./build.mjs",
  "outputDirectory": "dist",
  "functions": {
    "dist/index.mjs": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/index.mjs"
    }
  ]
}
